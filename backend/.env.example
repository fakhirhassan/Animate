# AniMate Flask Backend Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Server Configuration
PORT=5001
HOST=0.0.0.0

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=104857600

# Model Configuration
MODEL_WEIGHTS_PATH=models/two_d_to_three_d/model_weights
ENABLE_GPU=true

# JWT Authentication (future use)
JWT_SECRET_KEY=jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Supabase Configuration (REQUIRED)
# Get these from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://efxfsinczqravpeyutmp.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVmeGZzaW5jenFyYXZwZXl1dG1wIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjQyMjY0MDUsImV4cCI6MjA3OTgwMjQwNX0.8ha2Sl4g77Zj-3Seg4tphiYarVuswj-SCQ3SB2coc0Q
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVmeGZzaW5jenFyYXZwZXl1dG1wIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2NDIyNjQwNSwiZXhwIjoyMDc5ODAyNDA1fQ.ugblmw_Q8X9U7AoEGzxBpAMP_ou0nyweF6KDdTwGXQo

# Database Configuration (alternative to Supabase)
DATABASE_URL=sqlite:///dev_animate.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/animate_db

# AWS S3 Configuration (optional, for cloud storage)
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1

# External API Keys (future integrations)
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Redis Configuration (for async task processing)
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=DEBUG

# Rate Limiting
API_RATE_LIMIT=100 per hour

# RunPod Cloud GPU
GPU_MODE=auto
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_T2I_ENDPOINT_ID=
# 3D endpoint (TRELLIS) — falls back to RUNPOD_ENDPOINT_ID if empty
RUNPOD_3D_ENDPOINT_ID=
